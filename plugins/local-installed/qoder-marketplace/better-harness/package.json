{
  "name": "@ali/better-harness",
  "version": "0.2.20",
  "description": "Better Harness CLI, skills, templates, and guardrails for coding-agent workflows.",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.anpm.alibaba-inc.com"
  },
  "files": [
    ".qoder-plugin/",
    "assets/logo.svg",
    "models/",
    "!models/agent-work-loop-rationale.md",
    "references/",
    "scripts/",
    "!scripts/doc-link-graph.mjs",
    "!scripts/harness-analysis/apply-source-review.mjs",
    "!scripts/harness-analysis/episode-evidence-review.mjs",
    "!scripts/harness-analysis/report-review-packet.mjs",
    "!scripts/harness-analysis/score-finding-consistency.mjs",
    "!scripts/package/archive-markdown-links.mjs",
    "!scripts/package/verify-pack.mjs",
    "skills/",
    "!skills/**/.plugin-eval/",
    "templates/"
  ],
  "bin": {
    "better-harness": "scripts/better-harness.mjs",
    "qoder-harness": "scripts/better-harness.mjs"
  },
  "scripts": {
    "bundle:zip": "node scripts/package/create-bundle.mjs",
    "pack:verify": "node scripts/package/verify-pack.mjs",
    "publish:dry-run": "npm publish --dry-run --registry https://registry.anpm.alibaba-inc.com",
    "preview": "node dev/canvas-preview.mjs",
    "preview:canvas": "node dev/canvas-preview.mjs",
    "preview:html": "node dev/html-preview.mjs",
    "test": "node --test"
  },
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "esbuild-wasm": "0.28.1"
  }
}
