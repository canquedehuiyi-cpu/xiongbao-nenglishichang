{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${QODER_PLUGIN_ROOT}/scripts/prepare-cli.cmd\" --hook",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${QODER_PLUGIN_ROOT}/scripts/mode-gate.cmd\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${QODER_PLUGIN_ROOT}/scripts/mode-gate.cmd\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
