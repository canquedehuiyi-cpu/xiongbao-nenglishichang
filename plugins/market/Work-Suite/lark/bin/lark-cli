#!/bin/sh
# Stable plugin entrypoint. It delegates to a host-managed or public lark-cli runtime.
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
PLUGIN_INSTALL_ROOT="${LARK_CLI_INSTALL_ROOT:-$HOME/.local/share/qoder/lark-cli}"

if [ -n "${LARK_CLI_RUNTIME_EXECUTABLE:-}" ]; then
  if [ ! -x "$LARK_CLI_RUNTIME_EXECUTABLE" ] || [ ! -f "$LARK_CLI_RUNTIME_EXECUTABLE" ]; then
    printf '%s\n' 'LARK_CLI_RUNTIME_EXECUTABLE does not point to an executable runtime.' >&2
    exit 127
  fi
  exec "$LARK_CLI_RUNTIME_EXECUTABLE" "$@"
fi

for candidate in \
  "$PLUGIN_INSTALL_ROOT/node_modules/@larksuite/cli/bin/lark-cli" \
  "$PLUGIN_INSTALL_ROOT/node_modules/@larksuite/cli/bin/lark-cli.exe"
do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

for candidate in \
  "$HOME/.qoder/bin/lark-cli" \
  "$HOME/.qoder/bin/lark-cli.exe" \
  "$HOME/.qoder-cn/bin/lark-cli" \
  "$HOME/.qoder-cn/bin/lark-cli.exe"
do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

OLD_IFS="$IFS"
IFS=:
for dir in ${PATH:-}; do
  [ -n "$dir" ] || dir=.
  [ "$dir" = "$SCRIPT_DIR" ] && continue
  if [ -x "$dir/lark-cli" ]; then
    IFS="$OLD_IFS"
    exec "$dir/lark-cli" "$@"
  fi
  if [ -x "$dir/lark-cli.exe" ]; then
    IFS="$OLD_IFS"
    exec "$dir/lark-cli.exe" "$@"
  fi
done
IFS="$OLD_IFS"

for candidate in \
  "$HOME/.local/bin/lark-cli" \
  "$HOME/.local/bin/lark-cli.exe"
do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

printf '%s\n' '{"ok":false,"error":{"type":"runtime","subtype":"missing","message":"lark-cli is not installed","hint":"Ask the user for permission, then run lark-cli-install."}}' >&2
exit 127
